# Public - safe to expose to the browser (Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only - used by app/api/admin/watches/route.ts (never expose)
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used in broadcast/deep links (e.g. https://watch-vault-pi.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Viber broadcast (owner): auto-posts new listings to the Viber channel / GC
# Token from Channel info -> Developer Tools (see web-viber SETUP.md)
VIBER_AUTH_TOKEN=
# Optional sender id override; auto-discovered (superadmin) when unset
VIBER_FROM=
# Optional receiver id for group/community posts
VIBER_TARGET_ID=

# Public inquiry channels shown on catalog cards (empty = button hidden)
NEXT_PUBLIC_WHATSAPP=639206332503
NEXT_PUBLIC_MESSENGER=thewatchalley
